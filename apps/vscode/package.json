{
  "name": "team-topologies-modeler",
  "private": true,
  "version": "0.13.0",
  "displayName": "Team Topologies Modeler",
  "description": "View and edit Team Topologies diagrams directly in VS Code, including .tt and .ttm.json files.",
  "publisher": "miragon-gmbh",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Miragon/team-topologies-modeler.git",
    "directory": "apps/vscode"
  },
  "bugs": "https://github.com/Miragon/team-topologies-modeler/issues",
  "homepage": "https://github.com/Miragon/team-topologies-modeler/tree/main/apps/vscode#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "team topologies",
    "team",
    "topology",
    "diagram",
    "architecture"
  ],
  "main": "./dist/extension.cjs",
  "type": "module",
  "activationEvents": [
    "onCustomEditor:teamTopologies.editor",
    "onCustomEditor:teamTopologies.pngEditor"
  ],
  "contributes": {
    "languages": [
      {
        "id": "team-topologies",
        "aliases": [
          "Team Topologies",
          "team-topologies"
        ],
        "extensions": [
          ".tt",
          ".ttm.json"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./media/icons/team-topologies-light.svg",
          "dark": "./media/icons/team-topologies-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "team-topologies",
        "scopeName": "source.team-topologies",
        "path": "./syntaxes/team-topologies.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "teamTopologies.editor",
        "displayName": "Team Topologies Diagram",
        "selector": [
          {
            "filenamePattern": "*.tt"
          },
          {
            "filenamePattern": "*.ttm.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "teamTopologies.pngEditor",
        "displayName": "Team Topologies Diagram (PNG)",
        "selector": [
          {
            "filenamePattern": "*.tt.png"
          },
          {
            "filenamePattern": "*.ttm.png"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "teamTopologies.newDiagram",
        "title": "New Empty Diagram",
        "category": "Team Topologies",
        "shortTitle": "Team Topologies"
      },
      {
        "command": "teamTopologies.newFromExample",
        "title": "New Diagram from Example",
        "category": "Team Topologies"
      },
      {
        "command": "teamTopologies.newPngDiagram",
        "title": "New Empty Diagram (embedded PNG)",
        "category": "Team Topologies"
      },
      {
        "command": "teamTopologies.openSource",
        "title": "Open Source to the Side",
        "category": "Team Topologies",
        "icon": "$(go-to-file)"
      },
      {
        "command": "teamTopologies.openDiagram",
        "title": "Open Diagram to the Side",
        "category": "Team Topologies",
        "icon": "$(open-preview)"
      },
      {
        "command": "teamTopologies.fitView",
        "title": "Fit to View",
        "category": "Team Topologies"
      },
      {
        "command": "teamTopologies.exportPng",
        "title": "Export as PNG",
        "category": "Team Topologies"
      },
      {
        "command": "teamTopologies.exportSvg",
        "title": "Export as SVG",
        "category": "Team Topologies"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "teamTopologies.newDiagram",
          "group": "teamTopologies"
        },
        {
          "command": "teamTopologies.newPngDiagram",
          "group": "teamTopologies"
        }
      ],
      "editor/title": [
        {
          "command": "teamTopologies.openSource",
          "when": "activeCustomEditorId == teamTopologies.editor",
          "group": "navigation"
        },
        {
          "command": "teamTopologies.openDiagram",
          "when": "editorLangId == team-topologies",
          "group": "navigation"
        },
        {
          "command": "teamTopologies.fitView",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor",
          "group": "teamTopologies@1"
        },
        {
          "command": "teamTopologies.exportPng",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor",
          "group": "teamTopologies@2"
        },
        {
          "command": "teamTopologies.exportSvg",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor",
          "group": "teamTopologies@3"
        }
      ],
      "commandPalette": [
        {
          "command": "teamTopologies.openSource",
          "when": "activeCustomEditorId == teamTopologies.editor"
        },
        {
          "command": "teamTopologies.openDiagram",
          "when": "editorLangId == team-topologies"
        },
        {
          "command": "teamTopologies.fitView",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor"
        },
        {
          "command": "teamTopologies.exportPng",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor"
        },
        {
          "command": "teamTopologies.exportSvg",
          "when": "activeCustomEditorId == teamTopologies.editor || activeCustomEditorId == teamTopologies.pngEditor"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "getStarted",
        "title": "Get Started with Team Topologies Modeler",
        "description": "Create and edit Team Topologies diagrams — the four team types, three interaction modes, and flow-of-change — directly in VS Code.",
        "steps": [
          {
            "id": "create",
            "title": "Create your first diagram",
            "description": "Start from the bundled example or a blank canvas — it opens right in the visual editor.\n[Create diagram from example](command:teamTopologies.newFromExample)",
            "media": {
              "markdown": "media/walkthrough/create.md"
            },
            "completionEvents": [
              "onCommand:teamTopologies.newFromExample"
            ]
          },
          {
            "id": "source",
            "title": "Open the source to the side",
            "description": "The file is the diagram: edit its JSON beside the canvas and watch both stay in sync.\n[Open Source to the Side](command:teamTopologies.openSource)",
            "media": {
              "markdown": "media/walkthrough/source.md"
            },
            "completionEvents": [
              "onCommand:teamTopologies.openSource"
            ]
          },
          {
            "id": "learn",
            "title": "Learn the basics",
            "description": "Get to know the four team types, the three interaction modes, and how to draw teams and interactions on the canvas.",
            "media": {
              "markdown": "media/walkthrough/learn.md"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc -p tsconfig.json",
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "package": "vsce package --no-dependencies -o team-topologies-modeler.vsix",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@miragon/modeler-shell": "0.4.0",
    "@miragon/team-topologies-renderer": "0.13.0",
    "@miragon/team-topologies-schema-model": "0.13.0",
    "@miragon/team-topologies-ui": "0.13.0",
    "diagram-js": "15.28.1",
    "didi": "12.0.0",
    "jsonc-parser": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tiny-svg": "4.1.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/vscode": "1.96.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
